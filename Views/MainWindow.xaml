<Window x:Class="SimpleCompress.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小压匠" Width="620" Height="520"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Margin="28,22">
                <TextBlock Text="你想做什么？" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="选择文件，或直接把文件和文件夹拖到下面的区域。"
                           Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 两个主操作卡 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="CompressCard" Click="Compress_Click" Cursor="Hand"
                        BorderBrush="#cadcf8" BorderThickness="1" Background="#f6f9ff">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="22,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗕" FontSize="30" VerticalAlignment="Center"
                                               Foreground="{StaticResource Blue}" Margin="0,0,16,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="压缩文件" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="把文件或文件夹打包成压缩包"
                                                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" x:Name="ExtractCard" Click="Extract_Click" Cursor="Hand"
                        BorderBrush="#cde4da" BorderThickness="1" Background="#f4faf8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="22,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗗" FontSize="30" VerticalAlignment="Center"
                                               Foreground="{StaticResource Green}" Margin="0,0,16,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="解压文件" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="打开 ZIP、RAR、7Z 等压缩包"
                                                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Green}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 拖放区 -->
            <Border Grid.Row="1" x:Name="DropZone" Margin="0,22,0,0"
                    BorderBrush="#bbc9dc" BorderThickness="1" Background="#fcfdff" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="Tag" Value="over">
                                <Setter Property="Background" Value="#eaf2ff"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="0,26" HorizontalAlignment="Center">
                    <TextBlock Text="将文件或文件夹拖到这里" FontSize="15"
                               Foreground="#415571" HorizontalAlignment="Center"/>
                    <TextBlock Text="自动识别压缩或解压操作" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 底部 -->
            <DockPanel Grid.Row="3" Margin="0,22,0,0">
                <Button DockPanel.Dock="Right" Content="更多功能" Style="{StaticResource LinkButton}"
                        Click="More_Click"/>
                <Button DockPanel.Dock="Right" Content="设置" Style="{StaticResource LinkButton}"
                        Click="Settings_Click" Margin="0,0,6,0"/>
                <Button Content="打开压缩包…" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Click="OpenArchive_Click"/>
            </DockPanel>
        </Grid>

        <!-- 依赖缺失提示条 -->
        <Border Grid.Row="1" x:Name="EngineWarn" Background="#fff4e5" BorderBrush="#f0c89a"
                BorderThickness="0,0,0,1" VerticalAlignment="Top" Visibility="Collapsed" Padding="16,10">
            <TextBlock Text="未找到压缩引擎（7z.exe）。请把随包 tools\7z 放到程序目录，或在“设置”中指定引擎路径。"
                       FontSize="12" Foreground="#8a5a1e" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
