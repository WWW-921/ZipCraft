<Window x:Class="SimpleCompress.Views.BrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浏览压缩包内容" Width="640" Height="460"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadText" FontWeight="SemiBold" Margin="0,0,0,10"
                   TextTrimming="CharacterEllipsis"/>

        <ListView Grid.Row="1" x:Name="List" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="420">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Width="20"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="大小" Width="120" DisplayMemberBinding="{Binding Size}"/>
                    <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Kind}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="解压全部" Style="{StaticResource PrimaryButton}"
                    MinWidth="110" Click="ExtractAll_Click"/>
            <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource PlainButton}"
                    MinWidth="80" Margin="0,0,10,0" Click="Close_Click"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
        </DockPanel>
    </Grid>
</Window>
