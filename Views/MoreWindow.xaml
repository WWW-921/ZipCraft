<Window x:Class="SimpleCompress.Views.MoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更多功能" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="更多功能" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="偶尔用到的工具，都放在这里。" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource PlainButton}"
                    HorizontalContentAlignment="Left" Padding="18" Click="Browse_Click">
                <StackPanel><TextBlock Text="浏览压缩包内容" FontWeight="SemiBold"/><TextBlock Text="先查看文件，再决定是否解压" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource PlainButton}"
                    HorizontalContentAlignment="Left" Padding="18" Click="Test_Click">
                <StackPanel><TextBlock Text="测试压缩包完整性" FontWeight="SemiBold"/><TextBlock Text="检查文件是否完整、能否读取" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource PlainButton}"
                    HorizontalContentAlignment="Left" Padding="18" Click="PeaZip_Click">
                <StackPanel><TextBlock Text="PeaZip 完整界面" FontWeight="SemiBold"/><TextBlock Text="使用其他格式与专业工具" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource PlainButton}"
                    HorizontalContentAlignment="Left" Padding="18" Click="AdvCompress_Click">
                <StackPanel><TextBlock Text="高级压缩设置" FontWeight="SemiBold"/><TextBlock Text="密码、分卷与压缩等级" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
