<Window x:Class="SimpleCompress.Views.ExtractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解压文件" Width="560" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="解压文件" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="#f4f7fb" BorderBrush="#e5eaf2" BorderThickness="1"
                CornerRadius="6" Padding="14,11" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="重新选择" Style="{StaticResource LinkButton}"
                        Click="Reselect_Click"/>
                <StackPanel>
                    <TextBlock x:Name="SummaryName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SummaryCount" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="解压到"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="更改位置" Style="{StaticResource PlainButton}"
                        Margin="8,0,0,0" Click="BrowseDest_Click"/>
                <TextBox x:Name="DestBox"/>
            </DockPanel>
            <TextBlock x:Name="DestNote" Style="{StaticResource Hint}" Margin="0,8,0,0"
                       Text="默认在压缩包旁边创建同名文件夹，让文件更好找。"/>
        </StackPanel>

        <CheckBox Grid.Row="3" x:Name="OpenAfter" Content="完成后打开文件夹" Margin="0,18,0,0" IsChecked="True"/>

        <Expander Grid.Row="4" Header="高级选项" Margin="0,16,0,0" FontSize="13">
            <StackPanel Margin="0,12,0,4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="遇到同名文件"/>
                <ComboBox x:Name="ConflictBox">
                    <ComboBoxItem Content="每次询问（推荐）" Tag="ask" IsSelected="True"/>
                    <ComboBoxItem Content="保留两份" Tag="rename"/>
                    <ComboBoxItem Content="跳过" Tag="skip"/>
                    <ComboBoxItem Content="替换" Tag="overwrite"/>
                </ComboBox>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="“每次询问”会在真正解压前逐项确认，可选择“应用到全部”。"/>
            </StackPanel>
        </Expander>

        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="开始解压" Style="{StaticResource PrimaryButton}"
                    MinWidth="140" Click="Start_Click"/>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}"
                       Text="支持 ZIP、RAR、7Z 等格式。需要密码时会自动询问。"/>
        </DockPanel>
    </Grid>
</Window>
